# AuraWell Frontend Environment Variables
# Copy this file to .env.local for development
# For production deployment, set these in your Render environment variables

# Backend API URL
# Development: http://localhost:8080
# Production: Include your backend URL (can be same as frontend on Render)
VITE_API_URL=http://localhost:8080

# Public Site URL (used for canonical URLs, sitemap, robots.txt, Open Graph)
# This is the production URL where the site is publicly accessible
VITE_PUBLIC_SITE_URL=https://digital-student-wellness-and-counseling-y104.onrender.com

# Google Analytics 4 Measurement ID
# Tracking ID from Google Analytics console (format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-WQMFHF6T55

# Google Search Console Verification Code
# Get this from Google Search Console HTML tag verification method
# Leave empty if not using verification yet
# Format: unique alphanumeric string provided by Google
VITE_GOOGLE_SEARCH_CONSOLE_VERIFICATION=
